# Copy this file to `.env` and fill in real values. Never commit the real `.env`.

# --- Database ---
DATABASE_URL=sqlite:///./budget_tracker.db

# --- Auth / JWT ---
JWT_SECRET=replace-with-a-random-256-bit-value
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30

# --- Encryption at rest for Plaid access tokens ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=replace-with-a-generated-fernet-key

# --- Plaid ---
PLAID_CLIENT_ID=replace-with-your-plaid-client-id
PLAID_SECRET=replace-with-your-plaid-secret
# sandbox | development | production -- must match the client_id/secret pair above
PLAID_ENV=sandbox

# --- HTTPS (self-signed cert for LAN access) ---
SSL_CERT_PATH=./certs/cert.pem
SSL_KEY_PATH=./certs/key.pem

# --- CORS (only relevant when running the Vite dev server separately) ---
CORS_ALLOWED_ORIGIN=https://192.168.1.X:5173

# --- Rate limiting on auth endpoints ---
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_WINDOW_MINUTES=5
